<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retention & Advance Report Wizard Form -->
    <record id="view_cb_retention_report_wizard_form" model="ir.ui.view">
        <field name="name">cb.retention.report.wizard.form</field>
        <field name="model">cb.retention.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Retention &amp; Advance Report">
                <sheet>
                    <div class="oe_title">
                        <h2>Retention &amp; Advance Report</h2>
                        <p class="text-muted">
                            Generate an Excel report per customer and project as of any date, summarizing invoiced amounts, retention held, released, balances, advance received, recovered, and remaining balance.
                        </p>
                    </div>
                    <group>
                        <group string="Filters">
                            <field name="company_id" invisible="1"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="sale_order_id" options="{'no_create': True}"
                                   invisible="not partner_id"/>
                            <field name="as_of_date"/>
                        </group>
                        <group string="Download" invisible="not excel_file">
                            <field name="excel_filename" invisible="1"/>
                            <field name="excel_file" filename="excel_filename" readonly="1"
                                   widget="binary"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_excel" string="Export to Excel"
                            type="object" class="btn-primary" invisible="excel_file"/>
                    <button name="action_generate_excel" string="Regenerate Excel"
                            type="object" class="btn-secondary" invisible="not excel_file"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Report Wizard Action -->
    <record id="action_cb_retention_report_wizard" model="ir.actions.act_window">
        <field name="name">Retention &amp; Advance Report</field>
        <field name="res_model">cb.retention.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menuitem under Accounting > Reporting -->
    <menuitem id="menu_cb_retention_report"
              name="Retention &amp; Advance Report"
              action="action_cb_retention_report_wizard"
              parent="account.account_reports_management_menu"
              sequence="50"/>
</odoo>
